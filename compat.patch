+template <class V = V8>
+V8_INLINE void ToLocalEmpty() {
+  V::ToLocalEmpty();
+}
+template <class V = V8>
+V8_INLINE void FromJustIsNothing() {
+  V::FromJustIsNothing();
+}
+template <class V = V8>
+V8_INLINE void InternalFieldOutOfBounds(int index) {
+  V::InternalFieldOutOfBounds(index);
+}
+template <class V = V8>
+V8_INLINE Value* Eternalize(Isolate* isolate, Value* handle) {
+  return V::Eternalize(isolate, handle);
+}
+template <class V = V8>
+V8_INLINE internal::Address* CopyGlobalReference(internal::Address* from) {
+  return V::CopyGlobalReference(from);
+}
+template <class V = V8>
+V8_INLINE void MoveGlobalReference(internal::Address** from,
